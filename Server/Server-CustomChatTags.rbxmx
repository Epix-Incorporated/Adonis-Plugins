		<Item class="Script" referent="RBX02465722CF7C4926B352461158385760">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local MS = game:GetService("MarketplaceService")

local plr = Players.LocalPlayer
local chatWindowConfiguration = TextChatService.ChatWindowConfiguration
local chattags = script.Tags:GetChildren()
local TagsEnabled = script.TagEnabled

local function toHEX(color: Color3): string
	return string.format("#%02X%02X%02X", color.R * 0xFF, color.G * 0xFF, color.B * 0xFF)
end

local NameColors = {
	Color3.new(253/255, 41/255, 67/255), -- BrickColor.new("Bright red").Color,
	Color3.new(1/255, 162/255, 255/255), -- BrickColor.new("Bright blue").Color,
	Color3.new(2/255, 184/255, 87/255), -- BrickColor.new("Earth green").Color,
	BrickColor.new("Bright violet").Color,
	BrickColor.new("Bright orange").Color,
	BrickColor.new("Bright yellow").Color,
	BrickColor.new("Light reddish violet").Color,
	BrickColor.new("Brick yellow").Color,
}

-- Get Name Color
local function GetNameColor(Username)
	local Value = 0
	local NumName = #Username
	for index = 1, NumName do
		local CValue = string.byte(string.sub(Username, index, index))
		local ReverseIndex = NumName - index + 1
		if NumName % 2 == 1 then
			ReverseIndex = ReverseIndex - 1
		end
		if ReverseIndex % 4 >= 2 then
			CValue = -CValue
		end
		Value = Value + CValue
	end
	return NameColors[(Value % #NameColors) + 1]
end

TextChatService.OnChatWindowAdded = function(msg: TextChatMessage)
	local properties = chatWindowConfiguration:DeriveNewMessageProperties()

	local textSource = msg.TextSource
	
	if textSource then
		local plr = game.Players:GetPlayerByUserId(textSource.UserId)
		
		local NameColor;
		
		if plr.Team then
			NameColor = toHEX(plr.TeamColor.Color)
		else
			NameColor = toHEX(GetNameColor(plr.Name))
		end
		
		properties.PrefixText = string.format(`<font color='{NameColor}'>%s</font>`, msg.PrefixText)
		properties.Text = msg.Text
		properties.PrefixTextProperties = chatWindowConfiguration:DeriveNewMessageProperties()
		
		for i,v in chattags do
			local Name = v.Name
			local Users: string = v:GetAttribute("Users")
			local GroupID = v:GetAttribute("GroupID")
			local RankID = v:GetAttribute("RankID")
			local GamepassID = v:GetAttribute("GamepassID")
			local Color = v:GetAttribute("Gradient")
			
			if TagsEnabled.Value then
				local gradient = Instance.new("UIGradient")
				gradient.Color = Color
				
				if Users then
					for _,userId in Users:split(",") do
						local exists = Players:GetNameFromUserIdAsync(tonumber(userId))
						if not exists then continue end

						if textSource.UserId == tonumber(userId) then
							properties.PrefixText = `[{Name}]`
							properties.Text = string.format(`<font color='{NameColor}'>%s</font>`, msg.PrefixText) .. " " .. msg.Text
							properties.PrefixTextProperties = chatWindowConfiguration:DeriveNewMessageProperties()
							gradient:Clone().Parent = properties.PrefixTextProperties

							break;
						end
					end
				end

				if RankID and GroupID ~= nil then
					local plr = Players:GetPlayerByUserId(textSource.UserId)

					if plr:IsInGroup(GroupID) and plr:GetRankInGroup(GroupID) == RankID then
						properties.PrefixText = `[{v.Name}]`
						properties.Text = string.format(`<font color='{NameColor}'>%s</font>`, msg.PrefixText) .. " " .. msg.Text
						properties.PrefixTextProperties = chatWindowConfiguration:DeriveNewMessageProperties()
						gradient:Clone().Parent = properties.PrefixTextProperties

						break;
					end
				end

				if GamepassID and GamepassID ~= 0 then
					if MS:UserOwnsGamePassAsync(textSource.UserId, GamepassID) then
						properties.PrefixText = `[{v.Name}]`
						properties.Text = string.format(`<font color='{NameColor}'>%s</font>`, msg.PrefixText) .. " " .. msg.Text
						properties.PrefixTextProperties = chatWindowConfiguration:DeriveNewMessageProperties()
						gradient:Clone().Parent = properties.PrefixTextProperties

						break;
					end
				end
			end
		end	
	end

	return properties
end]]></ProtectedString>
