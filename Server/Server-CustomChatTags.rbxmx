<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="ModuleScript" referent="RBX45E449AB00E44BF7A3B7EF8E76D965A4">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[--[[
	Author: WalkerOfBacon
	Name: Chat Tags
	Description: This plugin will automatically create chat tags
	Place in a ModuleScript under Adonis_Loader > Config > Plugins and named "Server-CustomChatTags"
--]]

type ChatTagType = { --// The format of how you should input a new chat tag
	Name: string, --// The name of the chat tag
	Users: {number}?, --// The user IDs of the users 
	RankID: number?, --// The rank ID of the user (this will only apply if a GroupID is set)
	GamepassID: number?, --// The gamepass ID the user owns
	AdminLevel: number?, --// The Adonis admin level of the user
	Color: ColorSequence, --// The gradient of the tag
}

local AdminLevel: string|number = "HeadAdmins" --// The minimum admin level to be able to force chat tags
local GroupID = nil --// This is for groups

local CanToggle = true; --// You may edit this if you want the tags to be on by default or not

local ChatTags: {ChatTagType} = {
	--[[
		Example Chat Tag
		Only one of a user, rankID, gamepassID, or admin level is required
		
		{
			Name = "Name Tag";
			Users = {1234567890};
			RankID = 100;
			GamepassID = 1234567890;
			AdminLevel = 100;
			Color = ColorSequence.new{ --// The ColorSequence for the tag. It has to start from 0 to 1
				ColorSequenceKeypoint.new(0, Color3.fromRGB(13, 255, 0)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
			};
		}
	--]]
}

return function(Vargs)
	local server, service = Vargs.Server, Vargs.Service
	local Remote = server.Remote
	local Settings = server.Settings
	local Admin = server.Admin
	local Commands = server.Commands
	local Functions = server.Functions
	
	local MainScript = script.ChatColor
	
	if #ChatTags == 0 then return end
	
	service.HookEvent("PlayerAdded", function(plr: Player)
		local Main = MainScript:Clone()
		Main.Parent = plr.PlayerGui
		
		local TagsEnabled: BoolValue = Main:FindFirstChild("TagEnabled") or service.New("BoolValue", {
			Name = "TagEnabled",
			Parent = Main;
		})
		TagsEnabled.Value = CanToggle
		
		local Tags: Folder = Main:FindFirstChild("Tags") or service.New("Folder", {
			Name = "Tags";
			Parent = Main
		})
		
		for _,tag in ChatTags do
			if not tag.Users and not tag.RankID and not tag.GamepassID and not tag.AdminLevel then
				continue
			end

			local newTag: Configuration = service.New("Configuration", {
				Name = tag.Name,
				Parent = Tags
			})

			if tag.Users then
				newTag:SetAttribute("Users", table.concat(tag.Users, ","))
			end

			if tag.RankID and GroupID ~= nil then
				newTag:SetAttribute("GroupID", GroupID)
				newTag:SetAttribute("RankID", tag.RankID)
			end

			if tag.GamepassID then
				newTag:SetAttribute("GamepassID", tag.GamepassID)
			end

			if tag.AdminLevel then
				local level = Admin.GetLevel(plr)
				
				if level >= tag.AdminLevel then
					if tag.Users then
						table.insert(tag.Users, plr.UserId)
					else
						tag.Users = {plr.UserId}
					end
					
					newTag:SetAttribute("Users", table.concat(tag.Users, ","))
				end
			end

			newTag:SetAttribute("Gradient", tag.Color)
		end

		Remote.LoadCode(plr, [[
		local plr = service.Players.LocalPlayer;
		
		local Main = plr.PlayerGui.ChatColor;
		Main.Parent = plr.PlayerScripts;
		Main.Enabled = true;
		]])
	end)
	
	Commands.ToggleChatTags = {
		Prefix = Settings.PlayerPrefix;	-- Prefix to use for command
		Commands = {"chattag"};	-- Commands
		Args = {"on/off?"};
		Description = "Toggle whether your chat tag is on or off";	-- Command Description
		AdminLevel = "Players";	    -- Admin level; If using settings.CustomRanks set this to the custom rank name (eg. "Baristas")
		Function = function(plr: Player, args: {string})    -- Function to run for command
			local enabled;
			
			if CanToggle ~= true then
				Functions.Hint("Toggling your chat tag is currently disabled", {plr})
				return;
			end
			
			if args[1] then
				if args[1]:lower() == "on" then
					enabled = true
				elseif args[1]:lower() == "off" then
					enabled = nil
				end
			end
			
			Remote.LoadCode(plr, [[
			local plr = service.Players.LocalPlayer
			local TagEnabled = plr.PlayerScripts.ChatColor.TagEnabled
			local text = ""
			
			TagEnabled.Value = ]]..`{enabled}`..[[ or not TagEnabled.Value
			
			if TagEnabled.Value then
				text = "enabled"
			else
				text = "disabled"
			end
			
			client.UI.Make("Hint", {
				Message = "Your chat tag has been "..text..""
			})
			]])
		end
	}
	
	Commands.ForceChatTags = {
		Prefix = Settings.PlayerPrefix;	-- Prefix to use for command
		Commands = {"forcetags"};	-- Commands
		Args = {"on/off"};
		Description = "Toggle whether all chat tags are on or off";	-- Command Description
		AdminLevel = AdminLevel;
		Function = function(plr: Player, args: {string})    -- Function to run for command
			local enabled;
			assert(args[1], "Missing argument! (on/off)")

			if args[1]:lower() == "on" then
				enabled = true
				CanToggle = true
			elseif args[1]:lower() == "off" then
				enabled = false
				CanToggle = false
			end
			
			for _,v: Player in service.GetPlayers() do
				Remote.LoadCode(v, [[
				local plr = service.Players.LocalPlayer
				local TagEnabled = plr.PlayerScripts.ChatColor.TagEnabled
				
				TagEnabled.Value = ]]..`{enabled}`)
			end
			
			Functions.Hint(`All chattags have been {if enabled then "enabled" else "disabled"}.`, {plr})
		end
	}
end
]]></ProtectedString>
			<string name="ScriptGuid">{F23ECC3C-FD9C-44EC-A6ED-0A368B8B5A9C}</string>
			<BinaryString name="AttributesSerialize"></BinaryString>
